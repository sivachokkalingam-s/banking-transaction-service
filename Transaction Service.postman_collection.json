    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url",       "value": "http://localhost:3003", "type": "string" },
    { "key": "from_account",   "value": "ACC-1",                 "type": "string" },
    { "key": "to_account",     "value": "ACC-2",                 "type": "string" },
    { "key": "frozen_account", "value": "ACC-FROZEN-TEST",       "type": "string" },
    { "key": "closed_account", "value": "ACC-CLOSED-TEST",       "type": "string" },
    { "key": "transaction_id", "value": "",                      "type": "string" },
    { "key": "idempotency_key","value": "idem-key-run-001",      "type": "string" }
  ],
  "item": [
    {
      "name": "1. Observability",
      "item": [
        {
          "name": "Health Check",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Service name', () => pm.expect(b.service).to.eql('transaction-service'));",
            "pm.test('Status ok', () => pm.expect(b.status).to.eql('ok'));",
            "pm.test('Has database stats', () => pm.expect(b.database).to.have.property('transactions'));",
            "pm.test('Has dependency URLs', () => pm.expect(b.dependencies).to.have.property('accountService'));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/health" }
        },
        {
          "name": "Readiness Probe",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Ready', () => pm.expect(pm.response.json().status).to.eql('ready'));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/ready" }
        },
        {
          "name": "Prometheus Metrics",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "pm.test('Has transactions_total metric', () => pm.expect(pm.response.text()).to.include('transactions_total'));",
            "pm.test('Has failed_transfers_total', () => pm.expect(pm.response.text()).to.include('failed_transfers_total'));",
            "pm.test('Has balance_check_latency_ms', () => pm.expect(pm.response.text()).to.include('balance_check_latency_ms'));",
            "pm.test('Has daily_limit_rejections_total', () => pm.expect(pm.response.text()).to.include('daily_limit_rejections_total'));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/metrics" }
        },
        {
          "name": "Swagger UI",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));"
          ]}}],
          "request": { "method": "GET", "url": "{{base_url}}/api-docs" }
        }
      ]
    },
    {
      "name": "2. List & Get",
      "item": [
        {
          "name": "Get All Transactions (paginated)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('Returns transactions array', () => pm.expect(b.transactions).to.be.an('array'));",
            "pm.test('Has total count', () => pm.expect(b.total).to.be.a('number'));",
            "pm.test('Seeded data present (300+ records)', () => pm.expect(b.total).to.be.gte(300));",
            "if(b.transactions.length > 0) pm.collectionVariables.set('transaction_id', b.transactions[0].transaction_id);"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/transactions?limit=10&offset=0",
              "query": [{ "key": "limit", "value": "10" }, { "key": "offset", "value": "0" }] }
          }
        },
        {
          "name": "Filter by Type — DEPOSIT",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('All results are DEPOSIT', () => b.transactions.forEach(t => pm.expect(t.transaction_type).to.eql('DEPOSIT')));"
          ]}}],
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/v1/transactions?type=DEPOSIT&limit=5",
