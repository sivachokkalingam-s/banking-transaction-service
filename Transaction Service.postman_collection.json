          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/v1/transactions/transfer",
            "body": { "mode": "raw", "raw": "{\n  \"from_account_id\": \"{{from_account}}\",\n  \"to_account_id\": \"{{to_account}}\",\n  \"amount\": 9999,\n  \"idempotency_key\": \"{{idempotency_key}}\",\n  \"description\": \"Different amount — should 409\"\n}" }
          }
