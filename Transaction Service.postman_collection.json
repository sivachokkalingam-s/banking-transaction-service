    {
      "name": "5. Transfer",
      "item": [
        {
          "name": "Transfer — Success (first call, replay=false)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('Status 201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('success: true', () => pm.expect(b.success).to.be.true);",
            "pm.test('replay: false', () => pm.expect(b.replay).to.be.false);",
            "pm.test('Has debit_transaction', () => pm.expect(b.debit_transaction).to.exist);",
            "pm.test('Has credit_transaction', () => pm.expect(b.credit_transaction).to.exist);",
            "pm.test('Debit type TRANSFER_OUT', () => pm.expect(b.debit_transaction.transaction_type).to.eql('TRANSFER_OUT'));",
            "pm.test('Credit type TRANSFER_IN', () => pm.expect(b.credit_transaction.transaction_type).to.eql('TRANSFER_IN'));",
            "pm.test('Has daily_total_used', () => pm.expect(b.daily_total_used).to.be.a('number'));",
            "pm.test('Has daily_limit', () => pm.expect(b.daily_limit).to.eql(200000));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{base_url}}/v1/transactions/transfer",
            "body": { "mode": "raw", "raw": "{\n  \"from_account_id\": \"{{from_account}}\",\n  \"to_account_id\": \"{{to_account}}\",\n  \"amount\": 1000,\n  \"idempotency_key\": \"{{idempotency_key}}\",\n  \"description\": \"Rent payment\",\n  \"channel\": \"ONLINE\"\n}" }
          }
        },
