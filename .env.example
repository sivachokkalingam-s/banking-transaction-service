# ─────────────────────────────────────────────────────────────────────────────
# Transaction Service — Environment Variables
# Copy to .env for local development. Never commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Server
PORT=3003
NODE_ENV=development
SERVICE_NAME=transaction-service
SERVICE_VERSION=1.0.0

# Database (SQLite)
DB_PATH=./data/transactions.db

# Logging
LOG_LEVEL=info                  # error | warn | info | debug
MASK_SENSITIVE=true             # mask PII fields in logs

# ─── Business Rules ───────────────────────────────────────────────────────────
# Daily transfer cap per account (INR)
DAILY_TRANSFER_LIMIT=200000

# Threshold above which high-value notification is triggered (INR)
# NOTE: dataset max is ₹46,806 — seed includes synthetic ₹75k + ₹60k records
HIGH_VALUE_THRESHOLD=50000

# ─── HTTP Client (inter-service calls) ────────────────────────────────────────
REQUEST_TIMEOUT_MS=5000
MAX_RETRY_ATTEMPTS=3

# ─── Dependent Services ───────────────────────────────────────────────────────
# Docker Compose (single machine, shared banking-network):
ACCOUNT_SERVICE_URL=http://account-service:3002
NOTIFICATION_SERVICE_URL=http://notification-service:4104

# Kubernetes — same cluster (default DNS):
# ACCOUNT_SERVICE_URL=http://account-service:3002
# NOTIFICATION_SERVICE_URL=http://notification-service:4104

# Kubernetes — separate Minikube instances (each teammate runs their own):
# Step 1: get teammate's minikube ip  →  minikube ip   (e.g. 192.168.49.2)
# Step 2: find their service NodePort →  kubectl get svc account-service
# Step 3: set below:
# ACCOUNT_SERVICE_URL=http://192.168.49.2:30002
# NOTIFICATION_SERVICE_URL=http://192.168.49.3:30104
